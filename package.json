  "main": "app.js",
  "dependencies": {
    "archiver": "^5.3.1",
    "axios": "^1.13.2",
    "common-streams": "^1.4.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "@node-rs/argon2": "^2.0.2",
    "debug": "^4.3.4",
    "express": "^4.21.2",
    "fs-promise": "^2.0.3",
    "http-errors": "^2.0.0",
    "method-override": "^3.0.0",
    "morgan": "^1.10.0",
    "pug": "^3.0.2",
    "to-object-reducer": "^1.0.1",
    "uuid": "^9.0.1"
